# Primary price feed (Chaos Edge)
CHAOS_EDGE_BASE_URL=https://api.edge-inference.chaoslabs.xyz
CHAOS_EDGE_API_KEY=
CHAOS_EDGE_FEED_SOL_USD=
CHAOS_EDGE_FEED_ETH_USD=
CHAOS_EDGE_FEED_BTC_USD=

# Solana RPC (wallet sync + Jupiter)
NEXT_PUBLIC_SOLANA_RPC_URL=
# Required only for native Jupiter Mobile Adapter / WalletConnect flow in the iOS shell
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Optional explicit redirect target for Phantom mobile approval (defaults to the current page)
NEXT_PUBLIC_PHANTOM_REDIRECT_URL=
# Optional server-only RPC for trade broadcast route (/api/trade/send)
SOLANA_RPC_URL=

# Redis (required for durable push subscriptions/state across serverless instances)
REDIS_URL=

# Web push (required for push notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Native APNs push (required for remote push notifications in the iOS shell)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.bremlogic.signalsbot
# Paste the .p8 key contents with literal \n sequences or multiline env support
APNS_PRIVATE_KEY=
# true = Apple sandbox gateway, false = production gateway
APNS_USE_SANDBOX=true
CRON_SECRET=

# Jupiter Plugin local development toggle
NEXT_PUBLIC_IS_PLUGIN_DEV=true

# Claw3D office embed / launcher for the AI Trading Bot tab
# Example: https://your-tailnet-host
CLAW3D_OFFICE_URL=

# Perps automation engine
# Paper mode is the safe default. Live mode uses the user's own wallet session and remains approval-assisted.
PERPS_PAPER_TRADING=true
PERPS_KILL_SWITCH=false
PERPS_LIVE_ALLOWED_WALLETS=
NEXT_PUBLIC_PERPS_LIVE_ALLOWED_WALLETS=
PERPS_MAX_LEVERAGE=5
PERPS_MAX_TRADE_PCT=0.10
PERPS_MAX_EXPOSURE_PCT=0.50
PERPS_MAX_DAILY_LOSS_PCT=0.03
PERPS_COOLDOWN_SECONDS=60
PERPS_DUPLICATE_WINDOW_SECONDS=900
PERPS_ALLOWED_MARKETS=SOL-PERP,ETH-PERP,BTC-PERP
PERPS_MAX_SLIPPAGE_BPS=200
PERPS_ASSUMED_CAPITAL_USD=1000
PERPS_SESSION_HEARTBEAT_TIMEOUT_MS=45000
